{
  "manifest_version": 3,
  "name": "MS Rewards Auto-Searcher",
  "version": "1.0.0",
  "description": "Automatically runs 30 human-like Bing searches to earn Microsoft Rewards points daily.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.bing.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
